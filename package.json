{
  "name": "dsh-aoci-keeper",
  "version": "0.1.3",
  "description": "DSH plugin that keeps an AOCI cognition index aligned: runs aoci check against the session repository and reminds the model, once per turn, to maintain the index.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "aoci",
    "cognition-index",
    "agent-context",
    "index-drift"
  ],
  "scripts": {
    "test": "node --test tests/keeper.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3",
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrKleene/dsh-aoci-keeper.git"
  },
  "homepage": "https://github.com/MrKleene/dsh-aoci-keeper",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
